### macOS
# Finder metadata
.DS_Store
.AppleDouble
.LSOverride

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover

# Type checking
.mypy_cache/
.pytype/
.pyre/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Runtime / socket files
run/*.sock
run/*.pid

# Runtime storage (created at runtime)
storage/temp_queue.sqlite
storage/temp/

# Model binary files (large, managed separately)
model/*.onnx
model/*.pt
model/*.weights
model/*.rknn

# Jupyter
.ipynb_checkpoints/